# Copie para .env e ajuste localmente. .env nunca vai para o Git.
DB_NAME=agendamento_fotografia
DB_USER=agendamento_app
DB_PASSWORD=changeit
DB_PORT=5432
DB_HOST=localhost

# Credencial dedicada e minima para o endpoint publico de cadastro
# (POST /api/public/photographers/signup). Nao reutilizar DB_USER aqui -
# ver claude/fase-1.1-cadastro-fotografo.md para o motivo e o comando
# de criacao (passo manual, nao faz parte da migration).
DB_SIGNUP_USER=agendamento_signup
DB_SIGNUP_PASSWORD=changeit_signup
SERVER_PORT=8080

# Origens do frontend autorizadas via CORS (separadas por virgula).
# Default (quando omitido) ja cobre o Vite local: http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Credencial dedicada e minima para o bootstrap de login do fotografo
# (POST /api/public/photographers/login). Nao reutilizar DB_USER nem
# DB_SIGNUP_USER aqui - ver claude/fase-1.2-login-fotografo.md para o
# motivo e o comando de criacao (passo manual, nao faz parte da migration).
DB_LOGIN_USER=agendamento_login
DB_LOGIN_PASSWORD=changeit_login

# Chave secreta para o HMAC de access_attempts (rate limit de login/reset).
# NUNCA versionar o valor real; gerar uma vez por ambiente com:
#   openssl rand -base64 32
ACCESS_ATTEMPTS_HMAC_KEY=d6FIvf2hrqbg6JfSKTK2Qh+LeNw5D1Bw2ru2mnKJwTs=
