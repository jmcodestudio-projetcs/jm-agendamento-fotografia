# Copie para .env e ajuste localmente. .env nunca vai para o Git.
DB_NAME=agendamento_fotografia
DB_USER=agendamento_app
DB_PASSWORD=changeit
DB_PORT=5432
DB_HOST=localhost

# Credencial dedicada e minima para o endpoint publico de cadastro
# (POST /api/public/photographers/signup). Nao reutilizar DB_USER aqui -
# ver claude/fase-1.1-cadastro-fotografo.md para o motivo e o comando
# de criacao (passo manual, nao faz parte da migration).
DB_SIGNUP_USER=agendamento_signup
DB_SIGNUP_PASSWORD=changeit_signup
SERVER_PORT=8080

# Origens do frontend autorizadas via CORS (separadas por virgula).
# Default (quando omitido) ja cobre o Vite local: http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Credencial dedicada e minima para o bootstrap de login do fotografo
# (POST /api/public/photographers/login). Nao reutilizar DB_USER nem
# DB_SIGNUP_USER aqui - ver claude/fase-1.2-login-fotografo.md para o
# motivo e o comando de criacao (passo manual, nao faz parte da migration).
DB_LOGIN_USER=agendamento_login
DB_LOGIN_PASSWORD=changeit_login

# Chave secreta para o HMAC de access_attempts (rate limit de login/reset).
# NUNCA versionar o valor real; gerar uma vez por ambiente com:
#   openssl rand -base64 32
ACCESS_ATTEMPTS_HMAC_KEY=changeit_generate_with_openssl_rand_base64_32

# Credencial dedicada e minima para o bootstrap de recuperacao de senha
# (POST /api/public/photographers/password-reset/request e /confirm).
# Nao reutilizar DB_USER/DB_SIGNUP_USER/DB_LOGIN_USER aqui - ver
# claude/fase-1.3-recuperacao-acesso.md para o motivo e o comando de
# criacao (passo manual, nao faz parte da migration).
DB_RESET_USER=agendamento_reset
DB_RESET_PASSWORD=changeit_reset

# Credencial dedicada para o worker assincrono que envia os e-mails
# de autenticacao (recuperacao de senha, e futuramente codigo do admin)
# via Resend. So enxerga authentication_messages - ver
# claude/fase-1.3-recuperacao-acesso.md, decisao 5.
DB_WORKER_USER=agendamento_worker
DB_WORKER_PASSWORD=changeit_worker

# Papel dedicado ao Spring Session JDBC (sessoes HTTP em authentication.spring_session).
# Nao reutilizar DB_USER/DB_SIGNUP_USER/DB_LOGIN_USER/DB_RESET_USER/DB_WORKER_USER aqui -
# ver claude/fase-1.3-recuperacao-acesso.md (V7__session_bootstrap_role.sql).
DB_SESSION_USER=agendamento_session
DB_SESSION_PASSWORD=changeit_session

# Chave AES-256 (32 bytes, base64) para cifrar o payload das mensagens de
# autenticacao em authentication_messages (contem o link de recuperacao
# em claro ate ser enviado). NUNCA versionar o valor real; gerar uma vez
# por ambiente com:
#   openssl rand -base64 32
AUTH_MESSAGE_ENCRYPTION_KEY=changeit_generate_with_openssl_rand_base64_32

# Resend (envio de e-mail) - ver claude/fase-1.3-recuperacao-acesso.md,
# decisao 8. Chave em https://resend.com/api-keys; remetente precisa ser
# de um dominio verificado no Resend, nao um Gmail/Outlook pessoal.
RESEND_API_KEY=changeit_get_from_resend_dashboard
RESEND_FROM_EMAIL=changeit@seu-dominio-verificado.com.br

# Base do frontend, usada para montar o link de recuperacao de senha
# enviado por e-mail (ex.: http://localhost:5173/redefinir-senha?token=...).
FRONTEND_BASE_URL=http://localhost:5173

# Papel dedicado a features autenticadas/tenant-scoped via RLS (app.photographer_id).
# Diferente das roles anteriores, esta NAO e de uso unico de uma fase -- e reusada
# por toda feature futura que opere sobre dados de um fotografo autenticado
# (perfil, agenda, servicos, bloqueios, etc). Ver claude/fase-1.4-perfil-contatos-fuso.md
# (V8__tenant_profile_grant.sql e TenantDataSourceConfig).
DB_TENANT_USER=agendamento_tenant
DB_TENANT_PASSWORD=changeit_tenant

# Horario (cron, fuso do servidor) em que o worker de ciclo de vida do
# teste roda uma vez por dia (avisos de 7/1 dia e suspensao ao fim do
# teste sem assinatura). Reusa jm_worker/WorkerDataSourceConfig da 1.3 --
# nenhuma credencial nova aqui. Ver claude/fase-1.6-periodo-teste.md,
# decisao 5.
TRIAL_LIFECYCLE_CRON=0 0 3 * * *
